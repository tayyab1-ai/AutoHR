# Copy this file to .env and put the real values there.
# .env is listed in .gitignore and must not be committed.

DJANGO_SECRET_KEY=replace-with-a-long-random-string

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autohr
POSTGRES_PASSWORD=replace-with-the-local-postgres-password
POSTGRES_DB=autohr_n

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Gmail SMTP for signup OTP (App Password — see README / auth setup)
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# Aliases also supported: EMAIL_USER, EMAIL_PASS
DEFAULT_FROM_EMAIL=your.email@gmail.com
