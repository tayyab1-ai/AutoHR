# Copy this file to .env and put the real values there.
# .env is listed in .gitignore and must not be committed.

DJANGO_SECRET_KEY=replace-with-a-long-random-string

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autohr
POSTGRES_PASSWORD=replace-with-the-local-postgres-password
POSTGRES_DB=autohr_n
