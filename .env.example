# Copy this file to .env at the repo root (same folder as README.md).
# .env is gitignored — never commit secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-string

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autohr
POSTGRES_PASSWORD=replace-with-the-local-postgres-password
POSTGRES_DB=autohr_n

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth — one Cloud "Web application" client with TWO authorized redirect URIs:
#   http://127.0.0.1:8000/auth/google/callback/        (sign-in / sign-up)
#   http://127.0.0.1:8000/integrations/google/callback/  (workspace / calendar in profile)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/

# Fernet key for encrypting stored Google integration tokens (not used for login sessions)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Deployment / security (defaults are for local development) ---
# Set DJANGO_DEBUG=false on any real server. Then DJANGO_SECRET_KEY and TOKEN_ENCRYPTION_KEY are required,
# cookies become HTTPS-only, and HSTS + HTTPS redirect are enabled.
DJANGO_DEBUG=true
# Comma-separated host names this server answers to (required when DJANGO_DEBUG=false), e.g. hr.example.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated https origins, e.g. https://hr.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set true only behind a reverse proxy you control (nginx, load balancer)
TRUST_X_FORWARDED_FOR=false
DJANGO_BEHIND_HTTPS_PROXY=false

# Google Form responses are synced automatically in the background every N seconds (0 = off).
FORM_SYNC_INTERVAL_SECONDS=300
# Candidates can enter the interview room this many minutes before their slot.
INTERVIEW_ROOM_EARLY_ACCESS_MINUTES=15
# Show candidates a "Start interview now" option on the scheduling page (true/false).
INTERVIEW_ALLOW_START_NOW=true
# Speech-to-text language for interview answers (ISO code, e.g. en, ur). Default en. Use "auto" to auto-detect.
WHISPER_LANGUAGE=en
