# Copy this file to .env at the repo root (same folder as README.md).
# .env is gitignored — never commit secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-string

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autohr
POSTGRES_PASSWORD=replace-with-the-local-postgres-password
POSTGRES_DB=autohr_n

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth — one Cloud "Web application" client with TWO authorized redirect URIs:
#   http://127.0.0.1:8000/auth/google/callback/        (sign-in / sign-up)
#   http://127.0.0.1:8000/integrations/google/callback/  (workspace / calendar in profile)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/

# Fernet key for encrypting stored Google integration tokens (not used for login sessions)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
