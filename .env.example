# Copy this file to .env at the repo root (same folder as README.md).
# .env is gitignored — never commit secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-string

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autohr
POSTGRES_PASSWORD=replace-with-the-local-postgres-password
POSTGRES_DB=autohr_n

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Gmail SMTP for signup OTP (App Password — see README / auth setup)
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# Aliases also supported: EMAIL_USER, EMAIL_PASS
DEFAULT_FROM_EMAIL=your.email@gmail.com

# Google OAuth (Web application client — redirect URI must match Google Cloud console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/

# Fernet key for encrypting OAuth tokens (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
